<xsl:if test="@name!='time'">
  } else {
    <xsl:choose>
    
      <!--========== Array of structure ===========-->
      <xsl:when test = "@type = 'struct_array'">
        if (itmread-><xsl:value-of select = "$currentidxpath"/>.extent(0) != 0) {
        cout  &lt;&lt; "Error: (<xsl:value-of select = "@type"/>)<xsl:value-of select = "translate(@path,'/','.')"/> size = " &lt;&lt; itmread-><xsl:value-of select="$currentidxpath"/>.extent(0) &lt;&lt; endl;
        success = false;
        }
      </xsl:when>
      
      <!--========== Regular structure ===========-->
      <xsl:when test = "@type = 'structure'">
      </xsl:when>
      
      <!--============ Integer =============-->
      <xsl:when test = "@type = 'xs:integer'">
        if (itmread-><xsl:value-of select="$currentidxpath"/> != EMPTY_INT) {
        cout  &lt;&lt; "Error: (<xsl:value-of select = "@type"/>)<xsl:value-of select = "translate(@path,'/','.')"/> = " &lt;&lt; itmread-><xsl:value-of select="$currentidxpath"/> &lt;&lt; endl;
        success = false;
        }
      </xsl:when>
      
      <!--============ Float ==============-->
      <xsl:when test = "@type = 'xs:float'">
        if (itmread-><xsl:value-of select="$currentidxpath"/> != EMPTY_DOUBLE) {
        cout  &lt;&lt; "Error: (<xsl:value-of select = "@type"/>)<xsl:value-of select = "translate(@path,'/','.')"/> = " &lt;&lt; itmread-><xsl:value-of select="$currentidxpath"/> &lt;&lt; endl;
        success = false;
        }
      </xsl:when>
      
      <!--============= String ============-->
      <xsl:when test = "@type = 'xs:string'">
        if (itmread-><xsl:value-of select="$currentidxpath"/>.compare("")) {
        cout  &lt;&lt; "Error: (<xsl:value-of select = "@type"/>)<xsl:value-of select = "translate(@path,'/','.')"/> = " &lt;&lt; itmread-><xsl:value-of select="$currentidxpath"/> &lt;&lt; endl;
        success = false;
        }
      </xsl:when>
      
      
      <!--~=~=~=~=~= Array ~=~=~=~=~==-->
      <xsl:otherwise>
        if (itmread-><xsl:value-of select="$currentidxpath"/>.extent(0) != 0) {
        cout &lt;&lt; "Error: (<xsl:value-of select = "@type"/>)<xsl:value-of select = "translate(@path,'/','.')"/> = " &lt;&lt; itmread-><xsl:value-of select="$currentidxpath"/> &lt;&lt; endl;
        success=false;
        }
      </xsl:otherwise>
    </xsl:choose>
  }
</xsl:if>
</xsl:template>

</xsl:stylesheet>
