    int ItmNs::Itm::<xsl:value-of select="@type"/>::putNonTimed()
    {
        if(!connected) return -1;
        int dim1, dim2, dim3, dim4, dim5, dim6, dim7;
        int *intArray;
        double *doubleArray;
        int _i, _j, _k, _h, _l, _m, numSamples;
        char *str;
        char **stringArray;
        char *path = "<xsl:value-of select="@type"/>";
        double retTime;
        deleteAll();
<!-- DEPRECATED 
     discardCache();
-->
        int status = beginCPOPutNonTimed(expIdx,  "<xsl:value-of select="@type"/>");
        checkStatus(status);
        if(status) return status;
        <xsl:apply-templates select = "field" mode = "PUT_NON_TIMED" />
        endCPOPutNonTimed(expIdx, path);
        return 0;
    }
    
