    int ItmNs::Itm::<xsl:value-of select="@type"/>::getSlice(double inTime, char interpolMode)
    {
        if(!connected) return -1;
        int dim1, dim2, dim3, dim4, dim5, dim6, dim7, _i;
        int *intArray;
        double *doubleArray;
        char **stringArray;
        char *str;
        char *path = "<xsl:value-of select="@type"/>";
        double retTime;
        int status = beginCPOGetSlice(expIdx,  "<xsl:value-of select="@type"/>", inTime);
        checkStatus(status);
        if(status) return status;
        <xsl:apply-templates select = "field" mode = "GET_SLICE" />
        endCPOGetSlice(expIdx, path);
        return 0;
    }

    int ItmNs::Itm::<xsl:value-of select="@type"/>::getSlice(int idx, double inTime, char interpolMode)
    {
        if(!connected) return -1;
        int dim1, dim2, dim3, dim4, dim5, dim6,  dim7, _i;
        int *intArray;
        double *doubleArray;
        char **stringArray;
        char *str;
        char *basePath = "<xsl:value-of select="@type"/>";
        char path[strlen(basePath)+4];
	if(idx &lt; 1)
	    sprintf(path, "%s", basePath);
	else
	    sprintf(path, "%s/%d", basePath, idx);
        double retTime;
        int status = beginCPOGetSlice(expIdx,  path, inTime);
        checkStatus(status);
        if(status) return status;
        <xsl:apply-templates select = "field" mode = "GET_SLICE" />
        endCPOGetSlice(expIdx, path);
        return 0;
    }

    int ItmNs::Itm::<xsl:value-of select="@type"/>Array::get()
    {
      if(!connected) return -1;
      double *times;
      int _i, _j,_k, _h, _l, _m, numSamples, dim1, dim2, dim3, dim4, dim5, dim6, dim7, status, retSamples;
      int *intArray;
      char **stringArray;
      double *doubleArray;
      char *str;
      char *path = "<xsl:value-of select="@type"/>";
      status = beginCPOGet(expIdx, "<xsl:value-of select="@type"/>", TIMED, &amp;numSamples);
      checkStatus(status);
      if(status) return status;
      array.resize(numSamples);
      <xsl:apply-templates select = "field" mode = "GET_FULL"/>
      endCPOGet(expIdx, "<xsl:value-of select="@type"/>");
      return 0;
   }
    
    int ItmNs::Itm::<xsl:value-of select="@type"/>Array::get(int idx)
    {
      if(!connected) return -1;
      double *times;
      int _i, _j,_k, _h, _l, _m, numSamples, dim1, dim2, dim3, dim4, dim5, dim6, dim7, status, retSamples;
      int *intArray;
      char **stringArray;
      double *doubleArray;
      char *str;
      char *basePath = "<xsl:value-of select="@type"/>";
      char path[strlen(basePath)+4];
      if(idx &lt; 1)
	sprintf(path, "%s", basePath);
      else
	sprintf(path, "%s/%d", basePath, idx);
      status = beginCPOGet(expIdx, path, TIMED, &amp;numSamples);
      checkStatus(status);
      if(status) return status;
      array.resize(numSamples);
      <xsl:apply-templates select = "field" mode = "GET_FULL"/>
      endCPOGet(expIdx, path);
      return 0;
    }
    
  int ItmNs::Itm::<xsl:value-of select="@type"/>Array::put()
  {
    if(!connected) return -1;
    int status;
    int _i, _j, _k, _h, _l, _m, _n, numSamples, dim1, dim2, dim3, dim4, dim5, dim6, dim7;
    int *intArray;
    double *doubleArray;
    char **stringArray;
    double *times;
    int nTimes;
    int numElements = array.extent(0);
    char *path = "<xsl:value-of select="@type"/>";
    nTimes = array.extent(0);
    times = new double[nTimes];
    for(_i = 0; _i &lt; nTimes; _i++)
        times[_i] = array(_i).time;
    deleteAll();
<!-- DEPRECATED
     discardCache();
-->
    status = beginCPOPutTimed(expIdx, "<xsl:value-of select="@type"/>", array.extent(0), times);
    checkStatus(status);
    if(status) return status;
    <xsl:apply-templates select = "field" mode = "PUT_TIMED"/>
    delete[] times;
    endCPOPutTimed(expIdx, "<xsl:value-of select="@type"/>");
    return 0;
  }
  
  int ItmNs::Itm::<xsl:value-of select="@type"/>Array::put(int idx)
  {
    if(!connected) return -1;
    int status;
    int _i, _j, _k, _h, _l, _m, _n, numSamples, dim1, dim2, dim3, dim4, dim5, dim6, dim7;
    int *intArray;
    double *doubleArray;
    char **stringArray;
    double *times;
    int nTimes;
    int numElements = array.extent(0);
    char *basePath = "<xsl:value-of select="@type"/>";
    char path[strlen(basePath)+4];
    if(idx &lt; 1)
        sprintf(path, "%s", basePath);
    else
	sprintf(path, "%s/%d", basePath, idx);
    nTimes = array.extent(0);
    times = new double[nTimes];
    for(_i = 0; _i &lt; nTimes; _i++)
        times[_i] = array(_i).time;
    deleteAll(idx);
<!-- DEPRECATED
    discardCache(idx);
-->
    status = beginCPOPutTimed(expIdx, path, array.extent(0), times);
    checkStatus(status);
    if(status) return status;
    <xsl:apply-templates select = "field" mode = "PUT_TIMED"/>
    delete[] times;
    endCPOPutTimed(expIdx, path);
    return 0;
  }

<!-- DEPRECATED FUNCTIONS
  void Itm::<xsl:value-of select="@type"/>Array::discardCache()
  {
      char *path = "<xsl:value-of select="@type"/>";
      <xsl:apply-templates select = "field" mode = "DISCARD_CACHE" />
  }

  void Itm::<xsl:value-of select="@type"/>Array::discardCache(int idx)
  {
      char *basePath = "<xsl:value-of select="@type"/>";
      char path[strlen(basePath)+4];
      if(idx &lt; 1)
        sprintf(path, "%s", basePath);
      else
	sprintf(path, "%s/%d", basePath, idx);
      <xsl:apply-templates select = "field" mode = "DISCARD_CACHE" />
  }

  void Itm::<xsl:value-of select="@type"/>Array::flushCache()
  {
      char *path = "<xsl:value-of select="@type"/>";
      <xsl:apply-templates select = "field" mode = "FLUSH" />
  }

  void Itm::<xsl:value-of select="@type"/>Array::flushCache(int idx)
  {
      char *basePath = "<xsl:value-of select="@type"/>";
      char path[strlen(basePath)+4];
      if(idx &lt; 1)
        sprintf(path, "%s", basePath);
      else
	sprintf(path, "%s/%d", basePath, idx);
      <xsl:apply-templates select = "field" mode = "FLUSH" />
  }
-->

  </xsl:otherwise>
  </xsl:choose>
  </xsl:template>
    
 
<!--=================================================-->
<!--              field initialization               -->
<!--=================================================-->

<xsl:template match = "field" mode = "CONSTRUCTOR">
  <xsl:choose>
    <xsl:when test="@type='xs:integer'">
      <xsl:value-of select = "translate(@path,'/','.')"/>=EMPTY_INT;
    </xsl:when>
    <xsl:when test="@type='xs:double'">
      <xsl:value-of select = "translate(@path,'/','.')"/>=EMPTY_DOUBLE;
    </xsl:when>
    <xsl:when test="@type='xs:float'">
      <xsl:value-of select = "translate(@path,'/','.')"/>=EMPTY_DOUBLE;
    </xsl:when>
    <!-- Note that this template only initializes scalar field that are at the upper tree level.
         Scalar fields that are inside structures and arrays of structures
         are initialized by the constructors of the respective subclasses.
         See CPODef2Classes.xsl  -->
  </xsl:choose>
</xsl:template>

<!--=================================================-->
<!--                 delete fields                   -->
<!--=================================================-->

<xsl:template match = "field" mode = "DELETE">
  <xsl:choose>
     <xsl:when test="@type='structure'">
      <xsl:apply-templates select = "field" mode = "DELETE"/>
    </xsl:when>
    <xsl:otherwise>
    deleteData(expIdx, path, "<xsl:value-of select="@path"/>");
    </xsl:otherwise>
  </xsl:choose>
</xsl:template>


<!--=================================================-->
<!--               discard old cache                 -->
<!--=================================================-->

<xsl:template match = "field" mode = "DISCARD_OLD_CACHE">
  <xsl:choose>
    <xsl:when test = "@timed = 'yes'">
        euitm_discard_old_mem(expIdx, path, "<xsl:value-of select="@path"/>", time);
    </xsl:when>
   </xsl:choose>
   <xsl:choose>
     <xsl:when test="@type='structure'">
      <xsl:apply-templates select = "field" mode = "DISCARD_OLD_CACHE"/>
    </xsl:when>
  </xsl:choose>
</xsl:template>

<!--=================================================-->
<!--                 discard cache                   -->
<!--=================================================-->

<xsl:template match = "field" mode = "DISCARD_CACHE">
   <xsl:choose>
     <xsl:when test="@type='structure'">
      <xsl:apply-templates select = "field" mode = "DISCARD_CACHE"/>
    </xsl:when>
    <xsl:otherwise>
        euitm_discard_mem(expIdx, path, "<xsl:value-of select="@path"/>");
    </xsl:otherwise>    
  </xsl:choose>
</xsl:template>
    
    
<!--=================================================-->
<!--              print field content                -->
<!--=================================================-->

<xsl:template match = "field" mode = "DUMP">
  <xsl:param name="level"/>     <!-- recursion level -->
  <xsl:param name="idxpath"/>   <!-- full C++ path including indices -->

  <xsl:param name="currentidxpath" select="concat($idxpath,'.',@name)"/>
  
  <xsl:choose>
    <xsl:when test="@type='xs:string'">
      os &lt;&lt; "\n<xsl:value-of select="$currentidxpath"/>: ";
      if(<xsl:value-of select="$currentidxpath"/>.empty())
            os &lt;&lt; "EMPTY";
      else
             os &lt;&lt; <xsl:value-of select="$currentidxpath"/>;
    </xsl:when>
    <xsl:when test="@type='xs:integer'">
      os &lt;&lt; "\n<xsl:value-of select="$currentidxpath"/>: ";
      if(<xsl:value-of select="$currentidxpath"/> == EMPTY_INT)
            os &lt;&lt; "EMPTY";
      else
             os &lt;&lt; <xsl:value-of select="$currentidxpath"/>;
    </xsl:when>
    <xsl:when test="@type='xs:boolean'">
      os &lt;&lt; "\n<xsl:value-of select="$currentidxpath"/>: ";
      if(<xsl:value-of select="$currentidxpath"/> == EMPTY_INT)
            os &lt;&lt; "EMPTY";
      else
             os &lt;&lt; <xsl:value-of select="$currentidxpath"/>;
    </xsl:when>
    <xsl:when test="@type='xs:double'">
      os &lt;&lt; "\n<xsl:value-of select="$currentidxpath"/>: ";
      if(<xsl:value-of select="$currentidxpath"/> == EMPTY_DOUBLE)
            os &lt;&lt; "EMPTY";
      else
             os &lt;&lt; <xsl:value-of select="$currentidxpath"/>;
    </xsl:when>
    <xsl:when test="@type='xs:float'">
      os &lt;&lt; "\n<xsl:value-of select="$currentidxpath"/>: ";
      if(<xsl:value-of select="$currentidxpath"/> == EMPTY_DOUBLE)
            os &lt;&lt; "EMPTY";
      else
             os &lt;&lt; <xsl:value-of select="$currentidxpath"/>;
    </xsl:when>
    <xsl:when test="@type='structure'">
      <xsl:apply-templates select = "field" mode = "DUMP">
        <xsl:with-param name="level" select="$level"/>
        <xsl:with-param name="idxpath" select="$currentidxpath"/>
      </xsl:apply-templates>
    </xsl:when>
    <xsl:when test="@type='struct_array'">
      for (int i<xsl:value-of select="$level"/> = 0; i<xsl:value-of select="$level"/> &lt; <xsl:value-of select = "$idxpath"/>.<xsl:value-of select="@name"/>.extent(0); i<xsl:value-of select="$level"/>++) {
        <xsl:apply-templates select = "field" mode = "DUMP">
          <xsl:with-param name="level" select="$level + 1"/>
          <xsl:with-param name="idxpath" select="concat($currentidxpath,'(i',$level,')')"/>
        </xsl:apply-templates>
      }
    </xsl:when>
    <xsl:otherwise>
      os &lt;&lt; "\n<xsl:value-of select="$currentidxpath"/>: ";
      if(<xsl:value-of select="$currentidxpath"/>.extent(0) == 0)
            os &lt;&lt; "EMPTY";
      else
             os &lt;&lt; <xsl:value-of select="$currentidxpath"/>;
        
    </xsl:otherwise>
   </xsl:choose>
</xsl:template>


<!--=================================================-->
<!--       get field of a time-independent CPO       -->
<!--=================================================-->

<xsl:template match = "field" mode = "GET_SINGLE">
  <xsl:choose>
    <xsl:when test = "@timed = 'yes'">
      <!-- Cannot occur -->
    </xsl:when>
    <xsl:otherwise>
      <xsl:choose>
        <!--========== Simple types ==========-->
        <xsl:when test="@type='xs:string'">
          status = getString(expIdx, path, "<xsl:value-of select="@path"/>", &amp;str);
          checkStatus(status);
          if(!status) {
            <xsl:value-of select = "translate(@path,'/','.')"/>.assign(str);
              free(str);
          }
        </xsl:when>
        <xsl:when test="@type='xs:integer'">
          status = getInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;<xsl:value-of select = "translate(@path,'/','.')"/>);
          checkStatus(status);
        </xsl:when>
        <xsl:when test="@type='xs:boolean'">
          status = getInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;<xsl:value-of select = "translate(@path,'/','.')"/>);
          checkStatus(status);
        </xsl:when>
        <xsl:when test="@type='xs:double'">
          status = getDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;<xsl:value-of select = "translate(@path,'/','.')"/>);
          checkStatus(status);
        </xsl:when>
        <xsl:when test="@type='xs:float'">
          status = getDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;<xsl:value-of select = "translate(@path,'/','.')"/>);
          checkStatus(status);
        </xsl:when>
        
        <!--========== Vectors ==========-->
        <xsl:when test="@type='vecstring_type'">
          status = getVect1DString(expIdx, path, "<xsl:value-of select="@path"/>", &amp;stringArray, &amp;dim1);
          checkStatus(status);
          if(!status) {
            <xsl:value-of select = "translate(@path,'/','.')"/>.resize(dim1);
            for(_i = 0; _i &lt; dim1; _i++)
                <xsl:value-of select = "translate(@path,'/','.')"/>(_i).assign(stringArray[_i]);
            for(_i = 0; _i &lt; dim1; _i++)
              free(stringArray[_i]);
            free((char *)stringArray);
          }
        </xsl:when>
        <xsl:when test="@type='vecflt_type'">
          status = getVect1DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1);
          checkStatus(status);
          if(!status)  {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='vecdbl_type'">
          status = getVect1DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray), &amp;dim1);
          checkStatus(status);
          if(!status)  {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='vecint_type'">
          status = getVect1DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1);
            free(intArray);
          }
      </xsl:when>
        
        <!--========== Matrices ==========-->
        <xsl:when test="@type='matflt_type'">
          status = getVect2DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='matdbl_type'">
          status = getVect2DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='matint_type'">
          status = getVect2DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2);
            free(intArray);
          }
        </xsl:when>
        
        <!--========== 3D arrays ==========-->
        <xsl:when test="@type='array3dflt_type'">
          status = getVect3DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array3dint_type'">
          status = getVect3DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2, dim3);
            free(intArray);
          }
        </xsl:when>
        <xsl:when test="@type='array3ddbl_type'">
          status = getVect3DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3);
            free(doubleArray);
          }
        </xsl:when>
        
        <!--========== 4D arrays ==========-->
        <xsl:when test="@type='array4dflt_type'">
          status = getVect4DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array4dint_type'">
          status = getVect4DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2, dim3, dim4);
            free(intArray);
          }
        </xsl:when>
        <xsl:when test="@type='array4ddbl_type'">
          status = getVect4DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4);
            free(doubleArray);
          }
        </xsl:when>

        <!--========== 5D arrays ==========-->
        <xsl:when test="@type='array5dflt_type'">
          status = getVect5DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array5dint_type'">
          status = getVect5DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim4);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2, dim3, dim4, dim5);
            free(intArray);
          }
        </xsl:when>
        <xsl:when test="@type='array5ddbl_type'">
          status = getVect45Double(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim4);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5);
            free(doubleArray);
          }
        </xsl:when>

        <!--========== 6D arrays ==========-->
        <xsl:when test="@type='array6dflt_type'">
          status = getVect6DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, &amp;dim6);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5, dim6);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array6dint_type'">
          status = getVect6DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, &amp;dim6);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2, dim3, dim4, dim5, dim6);
            free(intArray);
          }
        </xsl:when>
        <xsl:when test="@type='array6ddbl_type'">
          status = getVect6Double(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, &amp;dim6);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5, dim6);
            free(doubleArray);
          }
        </xsl:when>

        <!--========== Arrays of structures ==========-->
        <xsl:when test="@type='struct_array'">
          {/*    Array of structure    */
            void *obj1;
            status = getObject(expIdx, path, "<xsl:value-of select = "@path"/>", &amp;obj1,0); // read the whole block
            checkStatus(status);
            if (!status) {
              <xsl:value-of select = "translate(@path,'/','.')"/>.resize(getObjectDim(expIdx,obj1));
              for (int i1 = 0; i1 &lt; getObjectDim(expIdx,obj1); i1++) {  // process array elements
                <xsl:apply-templates select = "field" mode = "GET_FROM_OBJECT">
                  <xsl:with-param name="level" select="1"/>
                  <xsl:with-param name="objpath" select="@name"/>
                  <xsl:with-param name="idxpath" select="concat(translate(@path,'/','.'),'(i1)')"/>
                  <xsl:with-param name="timed" select="'no'"/>
                </xsl:apply-templates>
              }
              releaseObject(expIdx,obj1);
            }
          }
        </xsl:when>
        
        <!--========== Regular structures ==========-->
        <xsl:when test="@type='structure'">
          <xsl:apply-templates select = "field" mode = "GET_SINGLE"/>
        </xsl:when>
      </xsl:choose>
    </xsl:otherwise>
  </xsl:choose>
</xsl:template>

<!--=================================================-->
<!--          get a full time-dependent CPO          -->
<!--=================================================-->

<xsl:template match = "field" mode = "GET_FULL">
  <xsl:choose>
    
    <!--************ Time-dependent fields ************-->
    <xsl:when test = "@timed = 'yes'">
      <xsl:choose>
        
        <!--========== Simple types ==========-->
        <xsl:when test="@type='xs:integer'">
          status = getVect1DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1);
          checkStatus(status);
          if(!status){
            for(_i = 0; _i &lt; dim1; _i++)
              array(_i).<xsl:value-of select = "translate(@path,'/','.')"/> = intArray[_i];
            free((char *)intArray);
          }
        </xsl:when>
        <xsl:when test="@type='xs:string'">
          status = getVect1DString(expIdx, path, "<xsl:value-of select="@path"/>", &amp;stringArray, &amp;dim1);
          checkStatus(status);
          if(!status) {
          for(_i = 0; _i &lt; dim1; _i++)
            array(_i).<xsl:value-of select = "translate(@path,'/','.')"/>.assign(stringArray[_i]);
          for(_i = 0; _i &lt; dim1; _i++)
            free(stringArray[_i]);
          free((char *)stringArray);
          }
        </xsl:when>
        <xsl:when test="@type='xs:boolean'">
          status = getVect1DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1);
          checkStatus(status);
          if(!status) {
            for(_i = 0; _i &lt; dim1; _i++)
              array(_i).<xsl:value-of select = "translate(@path,'/','.')"/> = intArray[_i];
            free((char *)intArray);
          }
        </xsl:when>
        <xsl:when test="@type='xs:double'">
          status = getVect1DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1);
