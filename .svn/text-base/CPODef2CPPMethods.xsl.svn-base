            dim4 = <xsl:value-of select="$currentidxpath"/>.extent(3);
            dim5 = <xsl:value-of select="$currentidxpath"/>.extent(4);
            doubleArray = new double[dim1*dim2*dim3*dim4*dim5];
            for(_i = 0; _i &lt; dim1; _i++)
            for(_j = 0; _j &lt; dim2; _j++)
