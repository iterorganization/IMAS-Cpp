        <xsl:when test="@type='array5ddbl_type'">
          status = getVect6DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5);
