          checkStatus(status);
          if(!status){
            for(_i = 0; _i &lt; dim7; _i++)
              setArray(array(_i).<xsl:value-of select = "translate(@path,'/','.')"/>,&amp;doubleArray[_i*dim1*dim2*dim3*dim4*dim5*dim6], dim1, dim2, dim3, dim4, dim5,dim6);
            free(doubleArray);
          }
