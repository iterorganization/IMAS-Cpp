          }
        </xsl:when>
        
        <!--========== 3D arrays ==========-->
        <xsl:when test="@type='array3dflt_type'">
          status = getVect4DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4);
