          }
-->

<!-- DEPRECATED FUNCTION (NEW MEM_CACHE SYSTEM)
          void Itm::<xsl:value-of select="@type"/>::flushCache()
          {
              char *path = "<xsl:value-of select="@type"/>";
              <xsl:apply-templates select = "field" mode = "FLUSH" />
          }
-->

<!-- DEPRECATED FUNCTION (NEW MEM_CACHE SYSTEM)
          void Itm::<xsl:value-of select="@type"/>::flushCache(int idx)
          {
              char *basePath = "<xsl:value-of select="@type"/>";
              char path[strlen(basePath)+4];
	      if(idx &lt; 1)
            	  sprintf(path, "%s", basePath);
	      else
            	  sprintf(path, "%s/%d", basePath, idx);
              <xsl:apply-templates select = "field" mode = "FLUSH" />
          }
-->

      </xsl:when>
      
<!--============ Define time-dependent CPOs ============-->      
      <xsl:otherwise>
          ItmNs::Itm::<xsl:value-of select="@type"/>::<xsl:value-of select="@type"/>()
          {
            <xsl:apply-templates select = "field" mode = "CONSTRUCTOR"/>
          }
          
    int ItmNs::Itm::<xsl:value-of select="@type"/>::putSlice(int idx)
    {
        if(!connected) return -1;
        int dim1, dim2, dim3, dim4, dim5, dim6, dim7;
        int *intArray;
        double *doubleArray;
        int _i, _j, _k, _h, _l, _m, _n;
        char *str;
        char *basePath = "<xsl:value-of select="@type"/>";
        char path[strlen(basePath)+4];
	if(idx &lt; 1)
	    sprintf(path, "%s", basePath);
	else
	    sprintf(path, "%s/%d", basePath, idx);
        double retTime;
        int status = beginCPOPutSlice(expIdx,  path);
        checkStatus(status);
        if(status) return status;
        <xsl:apply-templates select = "field" mode = "PUT_SLICE" />
        endCPOPutSlice(expIdx, path);
        return 0;
    }
    
    int ItmNs::Itm::<xsl:value-of select="@type"/>::putSlice()
    {
        if(!connected) return -1;
        int dim1, dim2, dim3, dim4, dim5, dim6, dim7;
        int *intArray;
        double *doubleArray;
        int _i, _j, _k, _h, _l, _m, _n;
        char *str;
        char *path = "<xsl:value-of select="@type"/>";
        double retTime;
        int status = beginCPOPutSlice(expIdx,  "<xsl:value-of select="@type"/>");
        checkStatus(status);
        if(status) return status;
        <xsl:apply-templates select = "field" mode = "PUT_SLICE" />
        endCPOPutSlice(expIdx, path);
        return 0;
    }
    
