<?xml version="1.0" encoding="UTF-8"?>
<?modxslt-stylesheet type="text/xsl" media="fuffa, screen and $GET[stylesheet]" href="./%24GET%5Bstylesheet%5D" alternate="no" title="Translation using provided stylesheet" charset="ISO-8859-1" ?>
<?modxslt-stylesheet type="text/xsl" media="screen" alternate="no" title="Show raw source of the XML file" charset="ISO-8859-1" ?>
<!-- Jo Lister, CRPP-EPFL, 2005, Generating  Fortran 90 code calls from XSD schemas -->
<!-- -->

<xsl:stylesheet xmlns:yaslt="http://www.mod-xslt2.com/ns/1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:xs="http://www.w3.org/2001/XMLSchema" version="1.0" extension-element-prefixes="yaslt"
  xmlns:fn="http://www.w3.orng/2005/02/xpath-functions">

<xsl:output method="text" version="1.0" encoding="UTF-8" indent="yes"/>

<xsl:template match = "/CPOs">
#include "UALClasses.h"

using namespace blitz;
using namespace ItmNs;

#define NON_TIMED    0
#define TIMED       1
#define TIMED_CLEAR 2

#ifdef DEBUG
    void checkStatus(int status) {if(status) printf("%s\n", euitm_last_errmsg());}
#else
    void checkStatus(int status){}
#endif

    ItmNs::Itm::Itm()
    {
        treeName = "euitm";
        connected = false;
        shot = refShot = run = refRun = -1;
    }
    ItmNs::Itm::Itm(int shot, int run, int refShot, int refRun)
    {
        treeName = "euitm";
        connected = false;
        this-> shot = shot;
        this->run = run;
        this->refShot = refShot;
        this->refRun = refRun;
        expIdx = -1;
    }
    ItmNs::Itm::Itm(int idx)
    {
        treeName = "euitm";
        connected = true;
        this-> shot = ual_get_shot(idx);
        this->run = ual_get_run(idx);
        this->refShot =  ual_get_shot(idx);
        this->refRun = ual_get_run(idx);
        expIdx = idx;
<xsl:apply-templates select = "CPO" mode = "SET_IDX"/>
    }
    void ItmNs::Itm::open() 
    {
        int idx;
        int status = euitm_open("euitm", shot, run, &amp;idx);
        if(status != 0)
        {
            printf("Error opening euitm shot %d, run %d: %s\n", shot, run, euitm_last_errmsg());
        }
        else
        {
            expIdx = idx;
            connected = true;
<xsl:apply-templates select = "CPO" mode = "SET_IDX"/>
        }
            
    }
    void ItmNs::Itm::openEnv(char *user, char *tokamak, char *version) 
    {
        int idx;
        int status = euitm_open_env("euitm", shot, run, &amp;idx, user, tokamak, version);
        if(status != 0)
        {
            printf("Error opening euitm shot %d, run %d: %s\n", shot, run, euitm_last_errmsg());
        }
        else
        {
            expIdx = idx;
            connected = true;
<xsl:apply-templates select = "CPO" mode = "SET_IDX"/>
        }
  
    }
    void ItmNs::Itm::openHdf5() 
    {
        int idx;
        int status = euitm_open_hdf5("euitm", shot, run, &amp;idx);
        if(status != 0)
        {
            printf("Error opening euitm shot %d, run %d: %s\n", shot, run, euitm_last_errmsg());
        }
        else
        {
            expIdx = idx;
            connected = true;
<xsl:apply-templates select = "CPO" mode = "SET_IDX"/>
        }
            
    }
    
    void ItmNs::Itm::create()
    {
        int idx;
        int status = euitm_create("euitm", shot, run, refShot, refRun, &amp; idx);
        if(status != 0)
        {
            printf("Error opening euitm shot %d, run %d: %s\n", shot, run, euitm_last_errmsg());
        }
        else
        {
            expIdx = idx;
            connected = true;
<xsl:apply-templates select = "CPO" mode = "SET_IDX"/>
        }
    }
    
    void ItmNs::Itm::createEnv(char *user, char *tokamak, char *version)
    {
        int idx;
        int status = euitm_create_env("euitm", shot, run, refShot, refRun, &amp; idx, user, tokamak, version);
        if(status != 0)
        {
            printf("Error opening euitm shot %d, run %d: %s\n", shot, run, euitm_last_errmsg());
        }
        else
        {
            expIdx = idx;
            connected = true;
<xsl:apply-templates select = "CPO" mode = "SET_IDX"/>
        }
    }
    
    void ItmNs::Itm::createHdf5()
    {
        int idx;
        int status = euitm_create_hdf5("euitm", shot, run, refShot, refRun, &amp; idx);
        if(status != 0)
        {
            printf("Error opening euitm shot %d, run %d: %s\n", shot, run, euitm_last_errmsg());
        }
        else
        {
            expIdx = idx;
            connected = true;
<xsl:apply-templates select = "CPO" mode = "SET_IDX"/>
        }
    }
    
    void ItmNs::Itm::close()
    {
        if(!connected) return;
        if(expIdx != -1)
            euitm_close(expIdx);
        connected = false;
    }

    void ItmNs::Itm::enableMemCache()
    {
        if(!connected) return;
        if(expIdx != -1)
            euitm_enable_mem_cache(expIdx);
    }
  
    void ItmNs::Itm::disableMemCache()
    {
        if(!connected) return;
        if(expIdx != -1)
            euitm_disable_mem_cache(expIdx);
    }


    void ItmNs::Itm::flushAll()
    {
        if(!connected) return;
        if(expIdx != -1)
            euitm_flush_mem_cache(expIdx);
    }

     void ItmNs::Itm::discardAll()
    {
        if(!connected) return;
        if(expIdx != -1)
            euitm_discard_mem_cache(expIdx);
    }

   int ItmNs::Itm::getTime(char *path, Array&lt;double,1&gt; &amp;time)
    {
        int retSamples;
        double *doubleArray;
        int dim;
  
        if(!connected) return -1;
        int status = beginCPOGet(expIdx,path,TIMED,&amp;retSamples);
        checkStatus(status);
        if(status) return status;
        status = getVect1DDouble(expIdx, path, "time", &amp;doubleArray, &amp;dim);
        checkStatus(status);
        if(!status) {
            Array&lt;double,1&gt; newArray(doubleArray, shape(dim), duplicateData, fortranArray);
            time.resize(newArray.shape());
            time = newArray;
            free(doubleArray);
        }
        endCPOGet(expIdx, path);
        return status;
    }

    ItmNs::Itm::~Itm()
    {
        /*if(expIdx != -1)
            euitm_close(expIdx);*/
    }
    
    <xsl:apply-templates select = "CPO" mode = "CLASS_DEFINITION"/>
     
    ostream &amp;ItmNs::operator &lt;&lt; (ostream &amp;os, const Itm &amp;obj)
    {
        os &lt;&lt; "TreeName: ";
        os &lt;&lt; obj.treeName;
        os &lt;&lt; "\nShot: ";
        os &lt;&lt;obj.shot;
        os &lt;&lt;"\nRun: ";
        os &lt;&lt;obj.run;
        os &lt;&lt;"\nRef Shot: ";
        os &lt;&lt;obj.refShot;
        os &lt;&lt;"\nRef Run: ";
        os &lt;&lt;obj.refRun;
        os &lt;&lt;((obj.connected)?"Connected":"Not Connected");
        return os;
    }
<xsl:apply-templates select = "CPO" mode = "DUMP"/>
    
</xsl:template>


<!--=================================================-->
<!--                 set idx in CPO                  -->
<!--=================================================-->

<xsl:template match = "CPO" mode = "SET_IDX">
    <xsl:choose>
        <xsl:when test = "@timed = 'no'">
        _<xsl:value-of select="@type"/>.setExpIdx(expIdx);    
        </xsl:when>
        <xsl:otherwise>
        _<xsl:value-of select="@type"/>.setExpIdx(expIdx);    
        _<xsl:value-of select="@type"/>Array.setExpIdx(expIdx);    
        </xsl:otherwise>
    </xsl:choose>
</xsl:template>


<!--=================================================-->
<!--               print CPO content                 -->
<!--=================================================-->

<xsl:template match = "CPO" mode = "DUMP">
    ostream &amp;ItmNs::operator &lt;&lt; (ostream &amp;os, const Itm::<xsl:value-of select="@type"/> &amp;obj)
    { 
          <xsl:apply-templates select = "field" mode = "DUMP">
            <xsl:with-param name="level" select="1"/>
            <xsl:with-param name="idxpath" select="'obj'"/>
          </xsl:apply-templates>
         return os;
    }
</xsl:template>


<!--=================================================-->
<!--               define CPO content                -->
<!--=================================================-->

<xsl:template match = "CPO" mode = "CLASS_DEFINITION">
  <xsl:choose>
    
  <!--============ Define time-independent CPOs ============-->
      <xsl:when test = "@timed = 'no'">
          ItmNs::Itm::<xsl:value-of select="@type"/>::<xsl:value-of select="@type"/>()
          {
            connected = false;
            <xsl:apply-templates select = "field" mode = "CONSTRUCTOR"/>
          }
          
          int Itm::<xsl:value-of select="@type"/>::get()
          {
            if(!connected) return -1;
            double *times;
            int i, _i, numSamples, dim1, dim2, dim3, dim4, dim5, dim6, dim7, status;
            int *intArray;
            char **stringArray;
            double *doubleArray;
            char *str;
            char *path = "<xsl:value-of select="@type"/>";
            status = beginCPOGet(expIdx, "<xsl:value-of select="@type"/>", NON_TIMED, &amp;numSamples);
            checkStatus(status);
            if (status) return status;
            <xsl:apply-templates select = "field" mode = "GET_SINGLE"/>
            endCPOGet(expIdx, "<xsl:value-of select="@type"/>");
            return 0;
          }
          
          int Itm::<xsl:value-of select="@type"/>::get(int idx)
          {
            if(!connected) return -1;
            double *times;
            int i, _i, numSamples, dim1, dim2, dim3, dim4, dim5, dim6, dim7, status;
            int *intArray;
            char **stringArray;
            double *doubleArray;
            char *str;
            char *basePath = "<xsl:value-of select="@type"/>";
            char path[strlen(basePath)+4];
	    if(idx &lt; 1)
            	sprintf(path, "%s", basePath);
	    else
            	sprintf(path, "%s/%d", basePath, idx);
            status = beginCPOGet(expIdx, path, NON_TIMED, &amp;numSamples);
            checkStatus(status);
            if (status) return status;
            <xsl:apply-templates select = "field" mode = "GET_SINGLE"/>
            endCPOGet(expIdx, path);
            return 0;
          }
          
          int Itm::<xsl:value-of select="@type"/>::put()
          {
            if(!connected) return -1;
            int status, dim1, dim2, dim3, dim4, dim5, dim6, dim7, _i, _j, _k, _h, _l, _m, _n;
            double *doubleArray;
            int *intArray;
            char **stringArray;
            char *path = "<xsl:value-of select="@type"/>";
            status = beginCPOPut(expIdx, "<xsl:value-of select="@type"/>");
            checkStatus(status);
            if(status) return status;
            <xsl:apply-templates select = "field" mode = "PUT_SINGLE"/>
            endCPOPut(expIdx, "<xsl:value-of select="@type"/>");
            return 0;
          }
            
          int Itm::<xsl:value-of select="@type"/>::put(int idx)
          {
            if(!connected) return -1;
            int status, dim1, dim2, dim3, dim4, dim5, dim6, dim7, _i, _j, _k, _h, _l, _m, _n, h;
            double *doubleArray;
            int *intArray;
            char **stringArray;
            char *basePath = "<xsl:value-of select="@type"/>";
            char path[strlen(basePath)+4];
	    if(idx &lt; 1)
            	sprintf(path, "%s", basePath);
	    else
            	sprintf(path, "%s/%d", basePath, idx);
            status = beginCPOPut(expIdx, path);
            checkStatus(status);
            if(status) return status;
            <xsl:apply-templates select = "field" mode = "PUT_SINGLE"/>
            endCPOPut(expIdx, path);
            return 0;
          }

          void Itm::<xsl:value-of select="@type"/>::flush()
          {
              char *path = "<xsl:value-of select="@type"/>";
              euitm_flush_cpo_mem_cache(expIdx, path);
          }
          void Itm::<xsl:value-of select="@type"/>::flush(int idx)
          {
              char *basePath = "<xsl:value-of select="@type"/>";
              char path[strlen(basePath)+4];
	      if(idx &lt; 1)
            	  sprintf(path, "%s", basePath);
	      else
            	  sprintf(path, "%s/%d", basePath, idx);
             euitm_flush_cpo_mem_cache(expIdx, path);
          }

          void Itm::<xsl:value-of select="@type"/>::discard()
          {
              char *path = "<xsl:value-of select="@type"/>";
              euitm_discard_cpo_mem_cache(expIdx, path);
          }
          void Itm::<xsl:value-of select="@type"/>::discard(int idx)
          {
              char *basePath = "<xsl:value-of select="@type"/>";
              char path[strlen(basePath)+4];
	      if(idx &lt; 1)
            	  sprintf(path, "%s", basePath);
	      else
            	  sprintf(path, "%s/%d", basePath, idx);
             euitm_discard_cpo_mem_cache(expIdx, path);
          }



<!-- DEPRECATED FUNCTION (NEW MEM_CACHE SYSTEM)
