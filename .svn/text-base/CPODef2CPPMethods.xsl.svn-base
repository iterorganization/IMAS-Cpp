          checkStatus(status);
          if(!status){
          for(_i = 0; _i &lt; numSamples; _i++)
          setArray(array(_i).<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4);
          free(doubleArray);
          }
        </xsl:when>
        
        <!--========== 5D arrays ==========-->
        <xsl:when test="@type='array5dflt_type'">
          status = getVect5DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5);
          checkStatus(status);
          if(!status){
          for(_i = 0; _i &lt; numSamples; _i++)
          setArray(array(_i).<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5);
          free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array5dint_type'">
          status = getVect5DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5);
          checkStatus(status);
          if(!status){
          for(_i = 0; _i &lt; numSamples; _i++)
          setArray(array(_i).<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2, dim3, dim4, dim5);
          free(intArray);
          }
        </xsl:when>
        <xsl:when test="@type='array5ddbl_type'">
          status = getVect5DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4);
          checkStatus(status);
          if(!status){
          for(_i = 0; _i &lt; numSamples; _i++)
          setArray(array(_i).<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5);
          free(doubleArray);
          }
        </xsl:when>
        
        <!--========== 6D arrays ==========-->
        <xsl:when test="@type='array6dflt_type'">
          status = getVect6DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, &amp;dim6);
          checkStatus(status);
          if(!status){
          for(_i = 0; _i &lt; numSamples; _i++)
          setArray(array(_i).<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5,dim6);
          free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array6dint_type'">
          status = getVect6DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, &amp;dim6);
          checkStatus(status);
          if(!status){
          for(_i = 0; _i &lt; numSamples; _i++)
          setArray(array(_i).<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2, dim3, dim4, dim5, dim6);
          free(intArray);
          }
        </xsl:when>
        <xsl:when test="@type='array6ddbl_type'">
          status = getVect6DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, &amp;dim6);
          checkStatus(status);
          if(!status){
          for(_i = 0; _i &lt; numSamples; _i++)
          setArray(array(_i).<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5,dim6);
          free(doubleArray);
          }
        </xsl:when>
        
        <!--========== Arrays of structures ==========-->
        <xsl:when test="@type='struct_array'">
          <!--  The following is not very efficient because we re-parse the object to fill every time slice.
                However, this is the same as for timed content. Moreover it is not the most common case -->
          {/*    Non-timed array of structure    */
            void *obj1;
            status = getObject(expIdx, path, "<xsl:value-of select = "@path"/>", &amp;obj1,0); // read the whole block
            checkStatus(status);
            if (!status) {
              for (int i0 = 0; i0 &lt; numSamples; i0++) {  // fill every time slice
                array(i0).<xsl:value-of select = "translate(@path,'/','.')"/>.resize(getObjectDim(expIdx,obj1));
                for (int i1 = 0; i1 &lt; getObjectDim(expIdx,obj1); i1++) {  // process array elements
                  <xsl:apply-templates select = "field" mode = "GET_FROM_OBJECT">
                    <xsl:with-param name="level" select="1"/>
                    <xsl:with-param name="objpath" select="@name"/>
                    <xsl:with-param name="idxpath" select="concat('array(i0).',translate(@path,'/','.'),'(i1)')"/>
                    <xsl:with-param name="timed" select="'no'"/>
                  </xsl:apply-templates>
                }
              }
              releaseObject(expIdx,obj1);
            }
          }
        </xsl:when>
        <!--========== Regular structures ==========-->
        <xsl:when test="@type='structure'">
          <xsl:apply-templates select = "field" mode = "GET_FULL"/>
        </xsl:when>
      </xsl:choose>
    </xsl:otherwise>
  </xsl:choose>
</xsl:template>

<!--=================================================-->
<!--               get field from a slice            -->
<!--=================================================-->

<xsl:template match = "field" mode = "GET_SLICE">
  <xsl:choose>
    <!--************ Time-dependent fields ************-->
    <xsl:when test = "@timed = 'yes'">
      
      <xsl:choose>
        <!--========== Simple types ==========-->
        <xsl:when test="@type='xs:integer'">
          status = getIntSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;<xsl:value-of select = "translate(@path,'/','.')"/>, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
        </xsl:when>
        <xsl:when test="@type='xs:string'">
          status = getStringSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;str, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) 
          {
            <xsl:value-of select = "translate(@path,'/','.')"/>.assign(str);
            free(str);
            time = retTime;
          }
        </xsl:when>
        <xsl:when test="@type='xs:boolean'">
          status = getIntSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;<xsl:value-of select = "translate(@path,'/','.')"/>, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
         </xsl:when>
        <xsl:when test="@type='xs:double'">
          status = getDoubleSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;<xsl:value-of select = "translate(@path,'/','.')"/>, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
        </xsl:when>
        <xsl:when test="@type='xs:float'">
          status = getDoubleSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;<xsl:value-of select = "translate(@path,'/','.')"/>, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
        </xsl:when>
        
        <!--========== Vectors ==========-->
        <xsl:when test="@type='vecflt_type'">
          status = getVect1DDoubleSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status)  {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1);
            time = retTime;
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='vecdbl_type'">
          status = getVect1DDoubleSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status)  {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1);
            time = retTime;
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='vecint_type'">
          status = getVect1DIntSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1);
            free(intArray);
          }
        </xsl:when>
        
        <!--========== Matrices ==========-->
        <xsl:when test="@type='matflt_type'">
          status = getVect2DDoubleSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='matdbl_type'">
          status = getVect2DDoubleSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='matint_type'">
          status = getVect2DIntSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2);
            free(intArray);
          }
        </xsl:when>
        
        <!--========== 3D arrays ==========-->
        <xsl:when test="@type='array3dflt_type'">
          status = getVect3DDoubleSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array3ddbl_type'">
          status = getVect3DDoubleSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array3dint_type'">
          status = getVect3DIntSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2, dim3);
            free(intArray);
          }
        </xsl:when>
 
        <!--========== 4D arrays ==========-->
        <xsl:when test="@type='array4dflt_type'">
          status = getVect4DDoubleSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array4ddbl_type'">
          status = getVect4DDoubleSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3,&amp;dim4,  inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array4dint_type'">
          status = getVect4DIntSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2, dim3, dim4);
            free(intArray);
          }
        </xsl:when>
        
        <!--========== 5D arrays ==========-->
        <xsl:when test="@type='array5dflt_type'">
          status = getVect5DDoubleSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array5ddbl_type'">
          status = getVect5DDoubleSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3,&amp;dim4, &amp;dim5,  inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array5dint_type'">
          status = getVect5DIntSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2, dim3, dim4, dim5);
            free(intArray);
          }
        </xsl:when>
        
        <!--========== 6D arrays ==========-->
        <xsl:when test="@type='array6dflt_type'">
          status = getVect6DDoubleSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, &amp;dim6, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5, dim6);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array6ddbl_type'">
          status = getVect6DDoubleSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3,&amp;dim4, &amp;dim5, &amp;dim6,  inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5, dim6);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array6dint_type'">
          status = getVect6DIntSlice(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, &amp;dim6, inTime, &amp;retTime, interpolMode);
          checkStatus(status);
          if(!status) {
            time = retTime;
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2, dim3, dim4, dim5, dim6);
            free(intArray);
          }
        </xsl:when>
        
        <!--========== Arrays of structures ==========-->
        <xsl:when test="@type='struct_array'">
          { /*     Timed array of structure     */
            /*    Read timed content    */
            void *obj_single_time;
            void *obj1;
            /* timed arrays of structures are included inside a time container, even if there is a single time */
            status = getObjectSlice(expIdx, path, "<xsl:value-of select = "@path"/>", inTime, &amp;obj_single_time); // read the whole timed block
            checkStatus(status);
            if (!status) {
              status = getObjectFromObject(expIdx,obj_single_time,"ALLTIMES",0,&amp;obj1);
              checkStatus(status);
              if (!status) {
                  <xsl:value-of select = "translate(@path,'/','.')"/>.resize(getObjectDim(expIdx,obj1));
                  for (int i1 = 0; i1 &lt; getObjectDim(expIdx,obj1); i1++) {     // process array elements
                    <xsl:apply-templates select = "field" mode = "GET_FROM_OBJECT">
                      <xsl:with-param name="level" select="1"/>
                      <xsl:with-param name="objpath" select="@name"/>
                      <xsl:with-param name="idxpath" select="concat(translate(@path,'/','.'),'(i1)')"/>
                      <xsl:with-param name="timed" select="'yes'"/>
                    </xsl:apply-templates>
                  }
                }
                releaseObject(expIdx,obj_single_time);
            }
            /*    Read non-timed content    */
            status = getObject(expIdx, path, "<xsl:value-of select = "@path"/>", &amp;obj1,0); // read the whole non-timed block
            checkStatus(status);
            if (!status) {
              // must have same number of non-timed elements and timed elements
              if (getObjectDim(expIdx,obj1) != 0 &amp;&amp; <xsl:value-of select = "translate(@path,'/','.')"/>.extent(0) != getObjectDim(expIdx,obj1)) {
                printf("Error in getSlice: array of structures has different number of timed and nontimed elements for <xsl:value-of select = "@path"/>\n");
                return -1;
              }
              for (int i1 = 0; i1 &lt; getObjectDim(expIdx,obj1); i1++) {  // process array elements
                <xsl:apply-templates select = "field" mode = "GET_FROM_OBJECT">
                  <xsl:with-param name="level" select="1"/>
                  <xsl:with-param name="objpath" select="@name"/>
                  <xsl:with-param name="idxpath" select="concat(translate(@path,'/','.'),'(i1)')"/>
                  <xsl:with-param name="timed" select="'no'"/>
                </xsl:apply-templates>
              }
              releaseObject(expIdx,obj1);
            }
          }
        </xsl:when>
        
        <!--========== Regular structure ==========-->
        <xsl:when test="@type='structure'">
          <xsl:apply-templates select = "field" mode = "GET_SLICE"/>
        </xsl:when>
      </xsl:choose>
    </xsl:when>
    <xsl:otherwise>
      <!--************ Non-time-dependent fields ************-->
      <xsl:choose>
        
        <!--========== Simple types ==========-->
        <xsl:when test="@type='xs:string'">
          status = getString(expIdx, path, "<xsl:value-of select="@path"/>", &amp;str);
          checkStatus(status);
          if(!status) {
            <xsl:value-of select = "translate(@path,'/','.')"/>.assign(str); free(str);
          }
        </xsl:when>
        <xsl:when test="@type='xs:integer'">
          status = getInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;<xsl:value-of select = "translate(@path,'/','.')"/>);
          checkStatus(status);
        </xsl:when>
        <xsl:when test="@type='xs:boolean'">
          status = getInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;<xsl:value-of select = "translate(@path,'/','.')"/>);
          checkStatus(status);
        </xsl:when>
        <xsl:when test="@type='xs:double'">
          status = getDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;<xsl:value-of select = "translate(@path,'/','.')"/>);
          checkStatus(status);
        </xsl:when>
        <xsl:when test="@type='xs:float'">
          status = getDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;<xsl:value-of select = "translate(@path,'/','.')"/>);
          checkStatus(status);
        </xsl:when>
        
        <!--========== Vectors ==========-->
        <xsl:when test="@type='vecstring_type'">
          status = getVect1DString(expIdx, path, "<xsl:value-of select="@path"/>", &amp;stringArray, &amp;dim1);
          checkStatus(status);
          if(!status) {
            <xsl:value-of select = "translate(@path,'/','.')"/>.resize(dim1);
            for(_i = 0; _i &lt; dim1; _i++)
                <xsl:value-of select = "translate(@path,'/','.')"/>(_i).assign(stringArray[_i]);
            for(_i = 0; _i &lt; dim1; _i++)
                free(stringArray[_i]);
            free((char *)stringArray);
          }
        </xsl:when>
        <xsl:when test="@type='vecflt_type'">
          status = getVect1DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='vecint_type'">
          status = getVect1DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1);
            free(intArray);
          }
        </xsl:when>
        <xsl:when test="@type='vecdbl_type'">
          status = getVect1DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1);
            free(doubleArray);
          }
        </xsl:when>
         
         <!--========== Matrices ==========-->
       <xsl:when test="@type='matflt_type'">
          status = getVect2DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='matdbl_type'">
          status = getVect2DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='matint_type'">
          status = getVect2DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2);
            free(intArray);
          }
        </xsl:when>
        
        <!--========== 3D arrays ==========-->
        <xsl:when test="@type='array3dflt_type'">
          status = getVect3DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array3ddbl_type'">
          status = getVect3DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array3dint_type'">
          status = getVect3DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2, dim3);
            free(intArray);
          }
        </xsl:when>

        <!--========== 4D arrays ==========-->
        <xsl:when test="@type='array4dflt_type'">
          status = getVect4DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array4ddbl_type'">
          status = getVect4DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array4dint_type'">
          status = getVect4DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2, dim3, dim4);
            free(intArray);
          }
        </xsl:when>
        
        <!--========== 5D arrays ==========-->
        <xsl:when test="@type='array5dflt_type'">
          status = getVect5DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array5ddbl_type'">
          status = getVect5DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array5dint_type'">
          status = getVect5DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2, dim3, dim4, dim5);
            free(intArray);
          }
        </xsl:when>
  
        <!--========== 6D arrays ==========-->
        <xsl:when test="@type='array6dflt_type'">
          status = getVect6DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, &amp;dim6);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5, dim6);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array6ddbl_type'">
          status = getVect6DDouble(expIdx, path, "<xsl:value-of select="@path"/>", &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, &amp;dim6);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,doubleArray, dim1, dim2, dim3, dim4, dim5, dim6);
            free(doubleArray);
          }
        </xsl:when>
        <xsl:when test="@type='array6dint_type'">
          status = getVect6DInt(expIdx, path, "<xsl:value-of select="@path"/>", &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, &amp;dim6);
          checkStatus(status);
          if(!status) {
            setArray(<xsl:value-of select = "translate(@path,'/','.')"/>,intArray, dim1, dim2, dim3, dim4, dim5, dim6);
            free(intArray);
          }
        </xsl:when>
  
        <!--========== Arrays of structures ==========-->
        <xsl:when test="@type='struct_array'">
          { /*    Non-timed array of structure    */
            void *obj1;
            status = getObject(expIdx, path, "<xsl:value-of select = "@path"/>", &amp;obj1,0); // read the whole block
            checkStatus(status);
            if (!status) {
              <xsl:value-of select = "translate(@path,'/','.')"/>.resize(getObjectDim(expIdx,obj1));
              for (int i1 = 0; i1 &lt; getObjectDim(expIdx,obj1); i1++) {  // process array elements
                <xsl:apply-templates select = "field" mode = "GET_FROM_OBJECT">
                  <xsl:with-param name="level" select="1"/>
                  <xsl:with-param name="objpath" select="@name"/>
                  <xsl:with-param name="idxpath" select="concat(translate(@path,'/','.'),'(i1)')"/>
                  <xsl:with-param name="timed" select="'no'"/>
                </xsl:apply-templates>
              }
              releaseObject(expIdx,obj1);
            }
          }
        </xsl:when>
        
        <!--========== Regular structures ==========-->
        <xsl:when test="@type='structure'">
          <xsl:apply-templates select = "field" mode = "GET_SLICE"/>
        </xsl:when>
      </xsl:choose>
    </xsl:otherwise>
  </xsl:choose>
</xsl:template>

<!--=================================================-->
<!--            get fields from an object            -->
<!--=================================================-->

<xsl:template match = "field" mode = "GET_FROM_OBJECT">
  <xsl:param name="level"/>     <!-- recursion level -->
  <xsl:param name="objpath"/>   <!-- path inside the object -->
  <xsl:param name="idxpath"/>   <!-- full C++ path including indices -->
  <xsl:param name="timed"/>     <!-- are we looking for timed or non-timed fields? -->
  
  <!-- build the path of the current field inside the object -->
  <xsl:param name="currentobjpath" select="concat($objpath,'/',@name)"/>
  <!-- build the complete path of the current field -->
  <xsl:param name="currentidxpath" select="concat($idxpath,'.',@name)"/>
  
  <xsl:choose>
    <!--========== Arrays of structures ==========-->
    <xsl:when test="@type='struct_array'">
      <xsl:if test="@timed='yes' or $timed='no'">  <!-- Non-timed struct_array must not appear in the timed section -->
        { /*    Array of structure     */
          void *obj<xsl:value-of select="$level + 1"/>;
          status = getObjectFromObject(expIdx, obj<xsl:value-of select="$level"/>, "<xsl:value-of select = "$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;obj<xsl:value-of select="$level + 1"/>);
          checkStatus(status);
          if (!status) {
            if (<xsl:value-of select="$currentidxpath"/>.extent(0)>0) { // does this array already exist? (timed and non timed parts can share the same array)
            if (getObjectDim(expIdx,obj<xsl:value-of select="$level + 1"/>) != 0 &amp;&amp; <xsl:value-of select="$currentidxpath"/>.extent(0) != getObjectDim(expIdx,obj<xsl:value-of select="$level + 1"/>)) { // then it must have the right number of elements
                printf("Error in get: array of structures has different number of timed and nontimed elements for <xsl:value-of select = "@path"/>\n");
                return -1;
              }
            } else { // else allocate it
              <xsl:value-of select="$currentidxpath"/>.resize(getObjectDim(expIdx,obj<xsl:value-of select="$level + 1"/>));
            }
            for (int i<xsl:value-of select="$level + 1"/> = 0; i<xsl:value-of select="$level + 1"/> &lt; getObjectDim(expIdx,obj<xsl:value-of select="$level + 1"/>); i<xsl:value-of select="$level + 1"/>++) {
              <xsl:apply-templates select = "field" mode = "GET_FROM_OBJECT">
                <xsl:with-param name="level" select="$level + 1"/>
                <xsl:with-param name="objpath" select="@name"/>
                <xsl:with-param name="idxpath" select="concat($currentidxpath,'(i',$level + 1,')')"/>
                <xsl:with-param name="timed" select="$timed"/>
              </xsl:apply-templates>
            }
          }
        }
      </xsl:if>
    </xsl:when>
        
    <!--========== Regular structure ==========-->
    <xsl:when test="@type='structure'">
      <xsl:apply-templates select = "field" mode = "GET_FROM_OBJECT">
        <xsl:with-param name="level" select="$level"/>
        <xsl:with-param name="objpath" select="$currentobjpath"/>
        <xsl:with-param name="idxpath" select="$currentidxpath"/>
        <xsl:with-param name="timed" select="$timed"/>
      </xsl:apply-templates>
    </xsl:when>
    
    <xsl:otherwise>
      <!--========== select either timed or non-timed fields ==========-->
      <xsl:if test="@timed=$timed">
        <xsl:choose>
        
          <!--========== Simple types ==========-->
          <xsl:when test="@type='xs:string'">
            status = getStringFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;str);
            checkStatus(status);
            if(!status) {<xsl:value-of select="$currentidxpath"/>.assign(str); free(str);
            }
          </xsl:when>
          <xsl:when test="@type='xs:integer'">
            status = getIntFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;<xsl:value-of select="$currentidxpath"/>);
            checkStatus(status);
          </xsl:when>
          <xsl:when test="@type='xs:boolean'">
            status = getIntFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;<xsl:value-of select="$currentidxpath"/>);
            checkStatus(status);
          </xsl:when>
          <xsl:when test="@type='xs:double'">
            status = getDoubleFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;<xsl:value-of select="$currentidxpath"/>);
            checkStatus(status);
          </xsl:when>
          <xsl:when test="@type='xs:float'">
            status = getDoubleFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;<xsl:value-of select="$currentidxpath"/>);
            checkStatus(status);
          </xsl:when>

          <!--========== Vectors ==========-->
          <xsl:when test="@type='vecstring_type'">
            status = getVect1DStringFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;stringArray, &amp;dim1);
            checkStatus(status);
            if(!status) {
                  <xsl:value-of select="$currentidxpath"/>.resize(dim1);
                  for(_i = 0; _i &lt; dim1; _i++)
                      <xsl:value-of select="$currentidxpath"/>(_i).assign(stringArray[_i]);
            for(_i = 0; _i &lt; dim1; _i++)
                  free(stringArray[_i]);
            free((char *)stringArray);
          }
          </xsl:when>
          <xsl:when test="@type='vecflt_type'">
            status = getVect1DDoubleFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;doubleArray, &amp;dim1);
            checkStatus(status);
            if(!status) {
            setArray(<xsl:value-of select="$currentidxpath"/>,doubleArray, dim1);
            free(doubleArray);
            }
          </xsl:when>
          <xsl:when test="@type='vecint_type'">
            status = getVect1DIntFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;intArray, &amp;dim1);
            checkStatus(status);
            if(!status) {
            setArray(<xsl:value-of select="$currentidxpath"/>,intArray, dim1);
            free(intArray);
            }
          </xsl:when>
          <xsl:when test="@type='vecdbl_type'">
            status = getVect1DDoubleFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;doubleArray, &amp;dim1);
            checkStatus(status);
            if(!status) {
            setArray(<xsl:value-of select="$currentidxpath"/>,doubleArray, dim1);
            free(doubleArray);
            }
          </xsl:when>

          <!--========== Matrices ==========-->
          <xsl:when test="@type='matflt_type'">
            status = getVect2DDoubleFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;doubleArray, &amp;dim1, &amp;dim2);
            checkStatus(status);
            if(!status) {
            setArray(<xsl:value-of select="$currentidxpath"/>,doubleArray, dim1, dim2);
            free(doubleArray);
            }
          </xsl:when>
          <xsl:when test="@type='matdbl_type'">
            status = getVect2DDoubleFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;doubleArray, &amp;dim1, &amp;dim2);
            checkStatus(status);
            if(!status) {
            setArray(<xsl:value-of select="$currentidxpath"/>,doubleArray, dim1, dim2);
            free(doubleArray);
            }
          </xsl:when>
          <xsl:when test="@type='matint_type'">
            status = getVect2DIntFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;intArray, &amp;dim1, &amp;dim2);
            checkStatus(status);
            if(!status) {
            setArray(<xsl:value-of select="$currentidxpath"/>,intArray, dim1, dim2);
            free(intArray);
            }
          </xsl:when>

          <!--========== 3D arrays ==========-->
          <xsl:when test="@type='array3dflt_type'">
            status = getVect3DDoubleFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3);
            checkStatus(status);
            if(!status) {
            setArray(<xsl:value-of select="$currentidxpath"/>,doubleArray, dim1, dim2, dim3);
            free(doubleArray);
            }
          </xsl:when>
          <xsl:when test="@type='array3ddbl_type'">
            status = getVect3DDoubleFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3);
            checkStatus(status);
            if(!status) {
            setArray(<xsl:value-of select="$currentidxpath"/>,doubleArray, dim1, dim2, dim3);
            free(doubleArray);
            }
          </xsl:when>
          <xsl:when test="@type='array3dint_type'">
            status = getVect3DIntFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3);
            checkStatus(status);
            if(!status) {
            setArray(<xsl:value-of select="$currentidxpath"/>,intArray, dim1, dim2, dim3);
            free(intArray);
            }
          </xsl:when>
  
          <!--========== 4D arrays ==========-->
          <xsl:when test="@type='array4dflt_type'">
            status = getVect4DDoubleFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4);
            checkStatus(status);
            if(!status) {
            setArray(<xsl:value-of select="$currentidxpath"/>,doubleArray, dim1, dim2, dim3, dim4);
            free(doubleArray);
            }
          </xsl:when>
          <xsl:when test="@type='array4ddbl_type'">
            status = getVect4DDoubleFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4);
            checkStatus(status);
            if(!status) {
            setArray(<xsl:value-of select="$currentidxpath"/>,doubleArray, dim1, dim2, dim3, dim4);
            free(doubleArray);
            }
          </xsl:when>
          <xsl:when test="@type='array4dint_type'">
            status = getVect4DIntFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4);
            checkStatus(status);
            if(!status) {
            setArray(<xsl:value-of select="$currentidxpath"/>,intArray, dim1, dim2, dim3, dim4);
            free(intArray);
            }
          </xsl:when>
          
          <!--========== 5D arrays ==========-->
          <xsl:when test="@type='array5dflt_type'">
            status = getVect5DDoubleFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5);
            checkStatus(status);
            if(!status) {
            setArray(<xsl:value-of select="$currentidxpath"/>,doubleArray, dim1, dim2, dim3, dim4, dim5);
            free(doubleArray);
            }
          </xsl:when>
          <xsl:when test="@type='array5ddbl_type'">
            status = getVect5DDoubleFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5);
            checkStatus(status);
            if(!status) {
            setArray(<xsl:value-of select="$currentidxpath"/>,doubleArray, dim1, dim2, dim3, dim4, dim5);
            free(doubleArray);
            }
          </xsl:when>
          <xsl:when test="@type='array5dint_type'">
            status = getVect5DIntFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5);
            checkStatus(status);
            if(!status) {
            setArray(<xsl:value-of select="$currentidxpath"/>,intArray, dim1, dim2, dim3, dim4, dim5);
            free(intArray);
            }
          </xsl:when>
  
          <!--========== 6D arrays ==========-->
          <xsl:when test="@type='array6dflt_type'">
            status = getVect6DDoubleFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, &amp;dim6);
            checkStatus(status);
            if(!status) {
              setArray(<xsl:value-of select="$currentidxpath"/>,doubleArray, dim1, dim2, dim3, dim4, dim5, dim6);
              free(doubleArray);
            }
          </xsl:when>
          <xsl:when test="@type='array6ddbl_type'">
            status = getVect6DDoubleFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;doubleArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, &amp;dim6);
            checkStatus(status);
            if(!status) {
              setArray(<xsl:value-of select="$currentidxpath"/>,doubleArray, dim1, dim2, dim3, dim4, dim5, dim6);
              free(doubleArray);
            }
          </xsl:when>
          <xsl:when test="@type='array6dint_type'">
            status = getVect6DIntFromObject(expIdx,obj<xsl:value-of select="$level"/>, "<xsl:value-of select="$currentobjpath"/>", i<xsl:value-of select="$level"/>, &amp;intArray, &amp;dim1, &amp;dim2, &amp;dim3, &amp;dim4, &amp;dim5, &amp;dim6);
            checkStatus(status);
            if(!status) {
              setArray(<xsl:value-of select="$currentidxpath"/>,intArray, dim1, dim2, dim3, dim4, dim5, dim6);
              free(intArray);
            }
          </xsl:when>
        </xsl:choose>
      </xsl:if>
    </xsl:otherwise>
  </xsl:choose>
  
</xsl:template>

<!--=================================================-->
<!--       put field of a time-independent CPO       -->
<!--=================================================-->

<xsl:template match = "field" mode = "PUT_SINGLE">
  <xsl:choose>
    
    <!--========== Simple types ==========-->
    <xsl:when test="@type='xs:string'">
      status = putString(expIdx, path, "<xsl:value-of select = "@path"/>", (char *)<xsl:value-of select = "translate(@path,'/','.')"/>.data(), <xsl:value-of select = "translate(@path,'/','.')"/>.size());
      checkStatus(status);
      if (status) return status;
    </xsl:when>
    <xsl:when test="@type='xs:integer'">
      status = putInt(expIdx, path, "<xsl:value-of select = "@path"/>", <xsl:value-of select = "translate(@path,'/','.')"/>);
      checkStatus(status);
      if (status) return status;
    </xsl:when>
    <xsl:when test="@type='xs:boolean'">
      status = putInt(expIdx, path, "<xsl:value-of select = "@path"/>", <xsl:value-of select = "translate(@path,'/','.')"/>);
      checkStatus(status);
      if (status) return status;
    </xsl:when>
    <xsl:when test="@type='xs:double'">
      status = putDouble(expIdx, path, "<xsl:value-of select = "@path"/>", <xsl:value-of select = "translate(@path,'/','.')"/>);
      checkStatus(status);
      if (status) return status;
    </xsl:when>
    <xsl:when test="@type='xs:float'">
      status = putDouble(expIdx, path, "<xsl:value-of select = "@path"/>", <xsl:value-of select = "translate(@path,'/','.')"/>);
      checkStatus(status);
      if (status) return status;
    </xsl:when>
    
    <!--========== Vectors ==========-->
    <xsl:when test="@type='vecflt_type'">
      dim1 = <xsl:value-of select = "translate(@path,'/','.')"/>.extent(0);
      doubleArray = new double[dim1];
      for(_i = 0; _i &lt;  dim1; _i++)
      doubleArray[_i] = <xsl:value-of select = "translate(@path,'/','.')"/>(_i);
      status = putVect1DDouble(expIdx, path, "<xsl:value-of select = "@path"/>", doubleArray, dim1, 0);
      delete[] doubleArray;
      checkStatus(status);
      if (status) return status;
    </xsl:when>
    <xsl:when test="@type='vecstring_type'">
      dim1 = <xsl:value-of select = "translate(@path,'/','.')"/>.extent(0);
      stringArray = new char*[dim1];
      for(_i = 0; _i &lt;  dim1; _i++)
      stringArray[_i] = (char *)<xsl:value-of select = "translate(@path,'/','.')"/>(_i).c_str();
      status = putVect1DString(expIdx, path, "<xsl:value-of select = "@path"/>", stringArray, dim1, 0);
      delete[] stringArray;
      checkStatus(status);
      if (status) return status;
    </xsl:when>
    <xsl:when test="@type='vecint_type'">
      dim1 = <xsl:value-of select = "translate(@path,'/','.')"/>.extent(0);
      intArray = new int[dim1];
      for(_i = 0; _i &lt;  dim1; _i++)
      intArray[_i] = <xsl:value-of select = "translate(@path,'/','.')"/>(_i);
      status = putVect1DInt(expIdx, path, "<xsl:value-of select = "@path"/>", intArray, dim1, 0);
      delete[] intArray;
      checkStatus(status);
      if (status) return status;
    </xsl:when>
    <xsl:when test="@type='vecdbl_type'">
      dim1 = <xsl:value-of select = "translate(@path,'/','.')"/>.extent(0);
      doubleArray = new double[dim1];
      for(_i = 0; _i &lt;  dim1; _i++)
      doubleArray[_i] = <xsl:value-of select = "translate(@path,'/','.')"/>(_i);
      status = putVect1DDouble(expIdx, path, "<xsl:value-of select = "@path"/>", doubleArray, dim1, 0);
      delete[] doubleArray;
      checkStatus(status);
      if (status) return status;
    </xsl:when>
    
    <!--========== Matrices ==========-->
    <xsl:when test="@type='matflt_type'">
      dim1 = <xsl:value-of select = "translate(@path,'/','.')"/>.extent(0);
      dim2 = <xsl:value-of select = "translate(@path,'/','.')"/>.extent(1);
      doubleArray = new double[dim1*dim2];
      for(_i = 0; _i &lt;  dim1; _i++)
      for(_j = 0; _j &lt;  dim2; _j++)
      doubleArray[_i + _j*dim1] = <xsl:value-of select = "translate(@path,'/','.')"/>(_i,_j);
      status = putVect2DDouble(expIdx, path, "<xsl:value-of select = "@path"/>", doubleArray, dim1, dim2, 0);
      delete[] doubleArray;
      checkStatus(status);
      if (status) return status;
    </xsl:when>
    <xsl:when test="@type='matdbl_type'">
      dim1 = <xsl:value-of select = "translate(@path,'/','.')"/>.extent(0);
