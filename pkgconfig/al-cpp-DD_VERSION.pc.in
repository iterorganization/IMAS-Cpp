prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: al-cpp-@DD_VERSION@
Version: @PROJECT_VERSION@
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Requires: @AL_CPP_CORE_PC_REQUIRES@ blitz
Cflags: -I${includedir} @AL_CPP_CORE_PC_CFLAGS@
Libs: -L${libdir} -lal-cpp-@DD_VERSION@ -Wl,--defsym,DD_VER_@DD_SAFE_VERSION@=0 -Wl,-rpath,${libdir}
