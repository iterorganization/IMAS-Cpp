include ../../../Makefile.common

ifeq "$(strip $(CC))" "icc"
CXX=icpc
LD=$(CXX)
CXXFLAGS=-g -O0 -fPIC -shared-intel
LDFLAGS=-g
else
CXX=g++
LD=$(CXX)
CXXFLAGS=-std=c++11 -pthread -g -O0 -fPIC
LDFLAGS=-g -pthread
endif

CXXFLAGS += `pkg-config al-cpp --cflags`
LDFLAGS  += `pkg-config al-cpp --libs`
BINOUT=TestSuite

IDSDEF = $(IMAS_PREFIX)/include/IDSDef.xml

include Makefile.tests
