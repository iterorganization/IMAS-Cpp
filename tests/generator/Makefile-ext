ifeq "$(strip $(CC))" "icc"
CXX=icpc
LD=$(CXX)
CXXFLAGS=-g -O0 -fPIC -shared-intel
LDFLAGS=-g
else
CXX=g++
LD=$(CXX)
CXXFLAGS=-std=c++11 -pthread -g -O0 -fPIC
LDFLAGS=-g -pthread
endif

INCDIR= `pkg-config blitz --cflags` `pkg-config al-cpp --cflags`
LIBS= `pkg-config blitz --libs` `pkg-config al-cpp --libs`
BINOUT=TestSuite

include Makefile.tests
